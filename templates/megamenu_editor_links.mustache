{{!
    @template local_urise/megamenu_editor_links

    The links of a block or card in the mega menu editor. Links can be dragged between blocks and cards.

    Example context (json):
    {
        "linkspath": "[\"tabs\",\"phd\",\"blocks\",\"b1\",\"links\"]",
        "links": [{"id": "l1", "label": "Datenmanagement", "typename": "Suche", "target": "\"Datenmanagement\"",
            "hastarget": true, "path": "[\"tabs\",\"phd\",\"blocks\",\"b1\",\"links\",\"l1\"]"}]
    }
}}
<ul class="list-unstyled mm-list mm-links" data-listtype="links" data-listpath="{{linkspath}}">
    {{#links}}
        <li class="mm-item d-flex align-items-center" data-path="{{path}}">
            <span class="mm-drag" data-drag="links" role="button" tabindex="0">{{#pix}}i/dragdrop, core, {{#str}}move{{/str}}{{/pix}}</span>
            {{> local_urise/megamenu_editor_link}}
        </li>
    {{/links}}
</ul>
<button type="button" class="btn btn-sm btn-link" data-action="mm-edit" data-form="link" data-path="{{linkspath}}">
    {{#pix}}t/add, core{{/pix}} {{#str}}megamenu:addlink, local_urise{{/str}}
</button>
