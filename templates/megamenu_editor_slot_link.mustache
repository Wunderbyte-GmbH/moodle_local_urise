{{!
    @template local_urise/megamenu_editor_slot_link

    The target of a tab entry in the mega menu editor.

    Example context (json):
    {
        "linkpath": "[\"tabs\",\"ai\",\"link\"]",
        "link": {"id": "l1", "label": "KI", "typename": "Suche", "target": "\"KI\"", "hastarget": true,
            "path": "[\"tabs\",\"ai\",\"link\"]"}
    }
}}
<div class="mm-section">
    <h4 class="h6">{{#str}}megamenu:target, local_urise{{/str}}</h4>
    {{#link}}
        <div class="mm-item">{{> local_urise/megamenu_editor_link}}</div>
    {{/link}}
    {{^link}}
        <button type="button" class="btn btn-sm btn-link" data-action="mm-edit" data-form="link" data-path="{{linkpath}}">
            {{#pix}}t/add, core{{/pix}} {{#str}}megamenu:settarget, local_urise{{/str}}
        </button>
    {{/link}}
</div>
