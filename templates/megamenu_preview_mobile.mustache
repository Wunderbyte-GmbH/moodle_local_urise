{{!
    @template local_urise/megamenu_preview_mobile

    The phone preview of the mega menu in the editor: the mobile drawer of theme_lexa with the menu item open,
    rendered with the theme templates theme_lexa/megamenu_mobile and theme_lexa/megamenu_mobile_panels.

    Context: the mega menu of \local_urise\megamenu\menu::export_for_template() with menulabel, logourl and sitename.

    Example context (json):
    {
        "menulabel": "Angebot", "sitename": "u:rise", "logourl": "",
        "tabs": [{"id": "phd", "label": "Doctoral Candidates", "haspanel": true, "color": "petrol", "iconsvg": "<svg></svg>"}]
    }
}}
<div class="mm-phone">
    <div class="mm-phone-header">
        {{#logourl}}<img src="{{logourl}}" alt="{{sitename}}" class="mm-phone-logo">{{/logourl}}
        {{^logourl}}<span class="mm-phone-sitename">{{sitename}}</span>{{/logourl}}
        <span class="mm-phone-close" aria-hidden="true">✕</span>
    </div>
    <div class="drawercontent">
        <div class="lexa-mm-mobile" data-region="lexa-megamenu-mobile">
            <div class="list-group lexa-mm-mobile-level" data-region="lexa-megamenu-mobile-level1">
                {{> theme_lexa/megamenu_mobile }}
            </div>
            {{> theme_lexa/megamenu_mobile_panels }}
        </div>
    </div>
</div>
