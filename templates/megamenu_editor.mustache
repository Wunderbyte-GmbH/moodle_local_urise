{{!
    @template local_urise/megamenu_editor

    The editor page of the mega menu. The structure is rendered again by amd/src/megamenu_editor.js after each change.

    Example context (json):
    {
        "revision": 3, "enabled": true, "haschanges": true, "previewurl": "https://example.com/?megamenupreview=1",
        "previewframeurl": "https://example.com/local/urise/megamenu_preview.php",
        "componentpicker": [{"type": "chips", "boxed": 0, "name": "Chips", "description": "Kleine Schlagworte", "samplehtml": ""}],
        "hastabs": true, "tabspath": "[\"tabs\"]",
        "tabs": [{"id": "phd", "label": "PhD", "typename": "Community", "haspanel": true, "color": "blue", "selected": true,
            "path": "[\"tabs\",\"phd\"]", "blocks": [], "secondarylinks": []}]
    }
}}
<div class="local-urise-megamenu-editor" data-region="megamenu-editor">
    <div class="mm-preview mb-4">
        <div class="d-flex align-items-start mb-2">
            <p class="text-muted small mb-0 mr-auto me-auto">{{#str}}megamenu:previewinfo, local_urise{{/str}}</p>
            <div class="btn-group btn-group-sm ml-3 ms-3 flex-shrink-0" role="group" aria-label="{{#str}}megamenu:view, local_urise{{/str}}">
                <button type="button" class="btn btn-outline-secondary active" data-action="mm-view" data-view="desktop" aria-pressed="true">
                    {{#str}}megamenu:view_desktop, local_urise{{/str}}
                </button>
                <button type="button" class="btn btn-outline-secondary" data-action="mm-view" data-view="mobile" aria-pressed="false">
                    {{#str}}megamenu:view_mobile, local_urise{{/str}}
                </button>
            </div>
        </div>
        <div class="mm-preview-frame" data-region="megamenu-preview">
            <iframe data-region="megamenu-preview-frame" title="{{#str}}megamenu:preview, local_urise{{/str}}"
                src="{{previewframeurl}}?tab={{#tabs}}{{#selected}}{{id}}{{/selected}}{{/tabs}}"
                data-src="{{previewframeurl}}" scrolling="no"></iframe>
        </div>
    </div>
    <div data-region="megamenu-editor-structure">
        {{> local_urise/megamenu_editor_structure}}
    </div>
    <template data-region="megamenu-picker">
        <p class="text-muted small">{{#str}}megamenu:choosecomponent_info, local_urise{{/str}}</p>
        <div class="mm-picker">
            {{#componentpicker}}
                <div class="mm-picker-tile">
                    <div class="mm-picker-sample" aria-hidden="true" inert>
                        <div class="lexa-megamenu lexa-megamenu-preview show lexa-mm-color-blue">{{{samplehtml}}}</div>
                    </div>
                    <div class="mm-picker-text">
                        <button type="button" class="btn btn-link p-0 stretched-link font-weight-bold fw-bold text-left text-start"
                            data-action="mm-pick" data-type="{{type}}" data-boxed="{{boxed}}">{{name}}</button>
                        <p class="small text-muted mb-0">{{description}}</p>
                    </div>
                </div>
            {{/componentpicker}}
        </div>
    </template>
</div>
{{#js}}
    require(['local_urise/megamenu_editor'], function(editor) {
        editor.init('[data-region="megamenu-editor"]');
    });
{{/js}}
