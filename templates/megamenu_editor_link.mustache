{{!
    @template local_urise/megamenu_editor_link

    A link in the mega menu editor.

    Example context (json):
    {
        "id": "l1", "label": "PhD Students", "typename": "Filter", "target": "Zielgruppe: PhD Students",
        "hastarget": true, "path": "[\"tabs\",\"phd\",\"cta\"]"
    }
}}
<div class="mm-link d-flex align-items-center flex-grow-1">
    <span class="mm-link-label">{{label}}</span>
    <span class="badge bg-light text-dark border">{{typename}}</span>
    <span class="mm-link-target text-truncate {{^hastarget}}text-danger{{/hastarget}}{{#hastarget}}text-muted{{/hastarget}}">{{target}}</span>
    <span class="ms-auto ml-auto text-nowrap">
        <button type="button" class="btn btn-sm btn-link p-1" data-action="mm-edit" data-form="link" data-path="{{path}}"
            title="{{#str}}edit{{/str}}">{{#pix}}t/edit, core, {{#str}}edit{{/str}}{{/pix}}</button>
        <button type="button" class="btn btn-sm btn-link p-1" data-action="mm-delete" data-path="{{path}}" data-name="{{label}}"
            title="{{#str}}delete{{/str}}">{{#pix}}t/delete, core, {{#str}}delete{{/str}}{{/pix}}</button>
    </span>
</div>
